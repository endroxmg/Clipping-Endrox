{
  "framework": null,
  "installCommand": "",
  "buildCommand": "node deploy/build-site.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/app/:path*", "destination": "/index.html" },
    { "source": "/:page(login|signup|settings|reset|admin|privacy|terms|acceptable-use)", "destination": "/index.html" },
    { "source": "/:page(workbench|auth|admin|reset|landing|legal).html", "destination": "/index.html" }
  ]
}
